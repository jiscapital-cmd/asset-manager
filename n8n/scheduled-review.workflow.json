{
  "name": "Asset Manager - Scheduled Review",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 6 1 * *" }]
        }
      },
      "name": "Monthly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/reviews/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": { "timeout": 600000 }
      },
      "name": "Run Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Reviews Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/reviews/run-portfolio",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": { "timeout": 600000 }
      },
      "name": "Run Portfolio Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Portfolio Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 360]
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": \"Asset Manager scheduled review API returned a non-200 response (\" + $json.statusCode + \") calling \" + $json.url + \" — the automation API may be down. This is a total-outage alert, distinct from the per-property failure notifications the API itself sends when it is reachable.\" } }}",
        "options": { "timeout": 10000 }
      },
      "name": "Alert: API Unreachable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Monthly Trigger": {
      "main": [
        [
          { "node": "Run Reviews", "type": "main", "index": 0 },
          { "node": "Run Portfolio Review", "type": "main", "index": 0 }
        ]
      ]
    },
    "Run Reviews": { "main": [[{ "node": "Reviews Succeeded?", "type": "main", "index": 0 }]] },
    "Reviews Succeeded?": {
      "main": [[], [{ "node": "Alert: API Unreachable", "type": "main", "index": 0 }]]
    },
    "Run Portfolio Review": { "main": [[{ "node": "Portfolio Succeeded?", "type": "main", "index": 0 }]] },
    "Portfolio Succeeded?": {
      "main": [[], [{ "node": "Alert: API Unreachable", "type": "main", "index": 0 }]]
    }
  },
  "meta": {
    "description": "Calls the Asset Manager automation API (asset_manager.automation.api) on the 1st of every month at 6am: POST /reviews/run for the per-property reviews, and POST /reviews/run-portfolio for a single cross-property digest (both run in parallel off the same trigger). The API itself sends Slack notifications per property/portfolio result when it is reachable (see SlackWebhookNotifier) — the 'Succeeded?' -> 'Alert: API Unreachable' branches in this workflow cover the case those in-API notifications can't: a non-200 response (or the API being down entirely), which needs its own alert since the API never got the chance to send one itself. This workflow's job is purely triggering the runs and reacting to their HTTP status — matching the spec's requirement that n8n triggers/reacts but the orchestrator never waits on it."
  }
}
