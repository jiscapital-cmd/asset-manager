# --- LLM / embeddings ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-...

# --- Google Drive (service account) ---
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# Not currently read by the code — safe to leave blank.
DRIVE_ROOT_FOLDER_ID=

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# --- Report archive ---
# Reports save to LOCAL DISK, not Drive: a service account has no storage
# quota of its own on a personal (non-Workspace) Google Drive, so it can't
# create new report files there even with Editor access on the folder.
# Local directory reports are written to (created automatically):
REPORTS_LOCAL_DIR=knowledge_base/reports
# Not currently read by the code — kept for when Drive-backed report storage
# becomes viable again (e.g. via a Workspace Shared Drive, which has pooled
# storage a service account CAN write into).
REPORTS_ROOT_FOLDER_ID=

# --- Per-property Drive folders ---
# One PROPERTY_FOLDER_<SLUG>=<drive-folder-id> line per pilot property.
# <SLUG> becomes the property_id used everywhere else (lowercased, as-is —
# e.g. PROPERTY_FOLDER_CHAMPIONS_POINTE -> property_id "champions_pointe").
# Each ID is that property's folder under raw_docs/ (the one containing
# financial/, pm/, capex/, general/ subfolders) — not raw_docs/ itself.
PROPERTY_FOLDER_CHAMPIONS_POINTE=
PROPERTY_FOLDER_MEMORIAL_APARTMENTS=
PROPERTY_FOLDER_GARFIELD_VISTA=
PROPERTY_FOLDER_MADGREY_APARTMENTS=

# --- Automation (Plan 3 — only needed for the scheduled-review API/n8n) ---
# Text notifications (Incoming Webhook — cannot upload files).
SLACK_WEBHOOK_URL=
# PDF file uploads for each scheduled report (Slack Web API — needs a Bot
# Token with the files:write scope, from a Slack app at api.slack.com/apps,
# plus the target channel's ID). Both optional: if either is missing, the
# scheduled API still runs fine with text notifications only, no file upload.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
